# iFood OAuth client (login redirects to http://localhost:${APP_PORT}/callback)
IFOOD_CLIENT_ID=
# Only if the token endpoint requires client authentication
IFOOD_CLIENT_SECRET=
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_AUTH_URL=https://id.ifood.com.br
# Leave empty: the client is not allowed to request the documented scopes
IFOOD_SCOPE=

# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Fallback chain, tried in order when a model is slow, overloaded or returns bad JSON.
# Only models with "structured_outputs" support (openrouter.ai/models). Free ones (:free) are rate-limited.
OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free
# Cheap paid alternative (a few cents per order):
# OPENROUTER_MODELS=anthropic/claude-haiku-5.5,deepseek/deepseek-v3.2,nvidia/nemotron-3-super-120b-a12b:free
# Seconds per model before trying the next one
LLM_TIMEOUT=25

APP_PORT=8000
MAX_STORES=3
# true = everything runs except the final submitOrder (safe demos)
DRY_RUN=false
