# iFood OAuth client (login redirects to http://localhost:${APP_PORT}/callback)
IFOOD_CLIENT_ID=
# Only if the token endpoint requires client authentication
IFOOD_CLIENT_SECRET=
IFOOD_MCP_URL=https://consumer-mcp.ifood.com.br/marketplace
IFOOD_AUTH_URL=https://id.ifood.com.br
# Leave empty: the client is not allowed to request the documented scopes
IFOOD_SCOPE=

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

APP_PORT=8000
MAX_STORES=3
